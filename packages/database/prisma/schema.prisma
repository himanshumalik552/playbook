generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum SystemRole {
  USER
  SUPER_ADMIN
}

enum OrgRole {
  ORGANIZATION_ADMIN
  MARKETING_MANAGER
  ANALYST
  VIEWER
}

enum IntegrationProvider {
  GOOGLE_ADS
  GOOGLE_ANALYTICS
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_ATTENTION
  ERROR
  REVOKED
}

enum CampaignStatus {
  ENABLED
  PAUSED
  REMOVED
}

enum CampaignObjective {
  SEARCH
  DISPLAY
  REMARKETING
  LEAD_GENERATION
  ECOMMERCE
}

enum ChannelType {
  SEARCH
  DISPLAY
  SHOPPING
  PERFORMANCE_MAX
  VIDEO
}

enum MatchType {
  EXACT
  PHRASE
  BROAD
}

enum Device {
  DESKTOP
  MOBILE
  TABLET
  OTHER
}

enum TargetScope {
  ORGANIZATION
  AD_ACCOUNT
  CAMPAIGN
}

enum TargetMetric {
  CPA
  ROAS
  CTR
  CONVERSION_RATE
  SPEND_PACING_TOLERANCE
}

enum AlertType {
  HIGH_SPEND_ZERO_CONVERSIONS
  CPA_ABOVE_TARGET
  ROAS_BELOW_TARGET
  CTR_BELOW_TARGET
  CPC_INCREASE
  CONVERSION_RATE_DECLINE
  SPEND_PACING
  IMPRESSIONS_DROP
  STRONG_ROAS_CONSTRAINED
  HIGH_BOUNCE_RATE
  MISSING_DATA
  CONVERSION_TRACKING_FAILURE
  SYNC_FAILED
  OAUTH_ATTENTION
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum EntityType {
  ORGANIZATION
  AD_ACCOUNT
  CAMPAIGN
  AD_GROUP
  KEYWORD
  SEARCH_TERM
  LANDING_PAGE
  DEVICE
  LOCATION
  CONNECTION
  SYNC_JOB
  OPTIMIZATION_ACTION
}

enum RecommendationType {
  REVIEW_EXPENSIVE_SEARCH_TERMS
  NEGATIVE_KEYWORD_CANDIDATES
  IMPROVE_AD_RELEVANCE
  LANDING_PAGE_CONVERSION_DECLINE
  REVIEW_DEVICE_PERFORMANCE
  REVIEW_LOCATION_PERFORMANCE
  CONTROLLED_BUDGET_SCALING
  REALLOCATE_BUDGET
}

enum RecommendationStatus {
  OPEN
  APPROVED
  DISMISSED
  CONVERTED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum ActionStatus {
  BACKLOG
  PLANNED
  IN_PROGRESS
  COMPLETED
  EVALUATED
  CANCELLED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ResultClassification {
  POSITIVE
  NEUTRAL
  NEGATIVE
  INCONCLUSIVE
}

enum ChangeSource {
  USER
  SYNC
  SYSTEM
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ReportFormat {
  PDF
  EXCEL
}

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum SyncType {
  INITIAL
  INCREMENTAL
  MANUAL
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String
  passwordHash     String?
  googleSubject    String?    @unique
  systemRole       SystemRole @default(USER)
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions            UserSession[]
  memberships         OrganizationMembership[]
  emailVerifications  EmailVerificationToken[]
  passwordResets      PasswordResetToken[]
  invitationsSent     OrganizationInvitation[] @relation("InvitedBy")
  assignedAlerts      Alert[]                  @relation("AlertAssignee")
  ownedActions        OptimizationAction[]     @relation("ActionOwner")
  createdActions      OptimizationAction[]     @relation("ActionCreator")
  actionComments      ActionComment[]
  decidedRecs         Recommendation[]         @relation("RecommendationDecider")
  requestedReports    GeneratedReport[]
  auditLogs           AuditLog[]
  changeLogs          ChangeLog[]
  reviewedSearchTerms SearchTerm[]
  createdTargets      PerformanceTarget[]      @relation("TargetUpdatedBy")
  oauthConnections    OAuthConnection[]
  syncJobs            SyncJob[]

  @@index([deletedAt])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  familyId         String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  replacedById     String?   @unique
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy UserSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   UserSession? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── Tenancy ───────────────────────────────

model Organization {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  currencyCode          String    @default("USD") @db.Char(3)
  timezone              String    @default("UTC")
  reportingPreferences  Json      @default("{}")
  branding              Json      @default("{}")
  dataRetentionDays     Int       @default(730)
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  lastScheduledSyncDate String?
  lastScheduledReport   Json      @default("{}")
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships        OrganizationMembership[]
  invitations        OrganizationInvitation[]
  connections        OAuthConnection[]
  adAccounts         AdAccount[]
  analyticsProps     AnalyticsProperty[]
  campaigns          Campaign[]
  adGroups           AdGroup[]
  keywords           Keyword[]
  searchTerms        SearchTerm[]
  landingPages       LandingPage[]
  accountMetrics     AccountDailyMetric[]
  campaignMetrics    CampaignDailyMetric[]
  adGroupMetrics     AdGroupDailyMetric[]
  keywordMetrics     KeywordDailyMetric[]
  searchTermMetrics  SearchTermDailyMetric[]
  deviceMetrics      DeviceDailyMetric[]
  locationMetrics    LocationDailyMetric[]
  landingPageMetrics LandingPageDailyMetric[]
  targets            PerformanceTarget[]
  alertRules         AlertRule[]
  alerts             Alert[]
  recommendations    Recommendation[]
  actions            OptimizationAction[]
  actionComments     ActionComment[]
  changeLogs         ChangeLog[]
  reportTemplates    ReportTemplate[]
  generatedReports   GeneratedReport[]
  syncJobs           SyncJob[]
  syncErrors         SyncError[]
  auditLogs          AuditLog[]

  @@index([deletedAt])
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

// ─────────────────────────────── Integrations ───────────────────────────────

model OAuthConnection {
  id                    String              @id @default(cuid())
  organizationId        String
  provider              IntegrationProvider
  status                ConnectionStatus    @default(ACTIVE)
  isMock                Boolean             @default(false)
  externalEmail         String?
  scopes                String[]
  /// AES-256-GCM ciphertext ("v1:iv:tag:data"); plain-text tokens are never persisted.
  encryptedRefreshToken String?
  connectedById         String?
  lastError             String?
  lastSuccessfulSyncAt  DateTime?
  revokedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy    User?               @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  adAccounts     AdAccount[]
  analyticsProps AnalyticsProperty[]
  syncJobs       SyncJob[]

  @@index([organizationId, provider, status])
}

model AdAccount {
  id                String    @id @default(cuid())
  organizationId    String
  connectionId      String?
  customerId        String
  managerCustomerId String?
  name              String
  currencyCode      String    @db.Char(3)
  timezone          String
  isManager         Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection      OAuthConnection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  campaigns       Campaign[]
  analyticsProps  AnalyticsProperty[]
  accountMetrics  AccountDailyMetric[]
  campaignMetrics CampaignDailyMetric[]
  targets         PerformanceTarget[]
  alerts          Alert[]
  recommendations Recommendation[]
  actions         OptimizationAction[]
  syncJobs        SyncJob[]

  @@unique([organizationId, customerId])
  @@index([organizationId, isActive])
}

model AnalyticsProperty {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String?
  adAccountId    String?
  propertyId     String
  name           String
  timezone       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   OAuthConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  adAccount    AdAccount?       @relation(fields: [adAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, propertyId])
}

// ─────────────────────────────── Advertising entities ───────────────────────────────

model Campaign {
  id             String            @id @default(cuid())
  organizationId String
  adAccountId    String
  externalId     String
  name           String
  status         CampaignStatus
  channelType    ChannelType
  objective      CampaignObjective
  dailyBudget    Decimal?          @db.Decimal(18, 6)
  startDate      DateTime?         @db.Date
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount       AdAccount                @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adGroups        AdGroup[]
  keywords        Keyword[]
  searchTerms     SearchTerm[]
  metrics         CampaignDailyMetric[]
  adGroupMetrics  AdGroupDailyMetric[]
  keywordMetrics  KeywordDailyMetric[]
  termMetrics     SearchTermDailyMetric[]
  deviceMetrics   DeviceDailyMetric[]
  locationMetrics LocationDailyMetric[]
  landingMetrics  LandingPageDailyMetric[]
  targets         PerformanceTarget[]
  alerts          Alert[]
  recommendations Recommendation[]
  actions         OptimizationAction[]

  @@unique([adAccountId, externalId])
  @@index([organizationId, adAccountId, status])
  @@index([organizationId, objective])
}

model AdGroup {
  id             String         @id @default(cuid())
  organizationId String
  adAccountId    String
  campaignId     String
  externalId     String
  name           String
  status         CampaignStatus
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  keywords     Keyword[]
  searchTerms  SearchTerm[]
  metrics      AdGroupDailyMetric[]
  actions      OptimizationAction[]

  @@unique([campaignId, externalId])
  @@index([organizationId, campaignId])
}

model Keyword {
  id             String         @id @default(cuid())
  organizationId String
  adAccountId    String
  campaignId     String
  adGroupId      String
  externalId     String
  text           String
  matchType      MatchType
  status         CampaignStatus
  qualityScore   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adGroup      AdGroup              @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  searchTerms  SearchTerm[]
  metrics      KeywordDailyMetric[]

  @@unique([adGroupId, externalId])
  @@index([organizationId, campaignId])
}

model SearchTerm {
  id             String    @id @default(cuid())
  organizationId String
  adAccountId    String
  campaignId     String
  adGroupId      String
  keywordId      String?
  term           String
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adGroup      AdGroup                 @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  keyword      Keyword?                @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  reviewedBy   User?                   @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  metrics      SearchTermDailyMetric[]

  @@unique([adGroupId, term])
  @@index([organizationId, campaignId])
  @@index([organizationId, term])
}

model LandingPage {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metrics      LandingPageDailyMetric[]

  @@unique([organizationId, url])
}

// ─────────────────────────────── Daily metrics ───────────────────────────────
// All `date` columns are the calendar date in the ad account's source timezone,
// stored as DATE (no time component) so ranges aggregate without timezone drift.

model AccountDailyMetric {
  id              String   @id @default(cuid())
  organizationId  String
  adAccountId     String
  date            DateTime @db.Date
  impressions     BigInt   @default(0)
  clicks          BigInt   @default(0)
  cost            Decimal  @default(0) @db.Decimal(18, 6)
  conversions     Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue Decimal  @default(0) @db.Decimal(18, 6)
  currencyCode    String   @db.Char(3)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount    AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, date])
  @@index([organizationId, date])
}

model CampaignDailyMetric {
  id                               String   @id @default(cuid())
  organizationId                   String
  adAccountId                      String
  campaignId                       String
  date                             DateTime @db.Date
  impressions                      Int      @default(0)
  clicks                           Int      @default(0)
  cost                             Decimal  @default(0) @db.Decimal(18, 6)
  conversions                      Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue                  Decimal  @default(0) @db.Decimal(18, 6)
  searchImpressionShare            Decimal? @db.Decimal(7, 4)
  searchTopImpressionShare         Decimal? @db.Decimal(7, 4)
  searchAbsoluteTopImpressionShare Decimal? @db.Decimal(7, 4)
  searchBudgetLostImpressionShare  Decimal? @db.Decimal(7, 4)
  currencyCode                     String   @db.Char(3)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount    AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([organizationId, adAccountId, date])
  @@index([organizationId, date, campaignId])
}

model AdGroupDailyMetric {
  id              String   @id @default(cuid())
  organizationId  String
  adAccountId     String
  campaignId      String
  adGroupId       String
  date            DateTime @db.Date
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost            Decimal  @default(0) @db.Decimal(18, 6)
  conversions     Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue Decimal  @default(0) @db.Decimal(18, 6)
  currencyCode    String   @db.Char(3)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adGroup      AdGroup      @relation(fields: [adGroupId], references: [id], onDelete: Cascade)

  @@unique([adGroupId, date])
  @@index([organizationId, campaignId, date])
  @@index([organizationId, adAccountId, date])
}

model KeywordDailyMetric {
  id              String   @id @default(cuid())
  organizationId  String
  adAccountId     String
  campaignId      String
  adGroupId       String
  keywordId       String
  date            DateTime @db.Date
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost            Decimal  @default(0) @db.Decimal(18, 6)
  conversions     Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue Decimal  @default(0) @db.Decimal(18, 6)
  qualityScore    Int?
  currencyCode    String   @db.Char(3)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  keyword      Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, date])
  @@index([organizationId, campaignId, date])
  @@index([organizationId, adAccountId, date])
}

model SearchTermDailyMetric {
  id              String   @id @default(cuid())
  organizationId  String
  adAccountId     String
  campaignId      String
  adGroupId       String
  searchTermId    String
  date            DateTime @db.Date
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost            Decimal  @default(0) @db.Decimal(18, 6)
  conversions     Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue Decimal  @default(0) @db.Decimal(18, 6)
  currencyCode    String   @db.Char(3)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  searchTerm   SearchTerm   @relation(fields: [searchTermId], references: [id], onDelete: Cascade)

  @@unique([searchTermId, date])
  @@index([organizationId, campaignId, date])
  @@index([organizationId, adAccountId, date])
}

model DeviceDailyMetric {
  id              String   @id @default(cuid())
  organizationId  String
  adAccountId     String
  campaignId      String
  date            DateTime @db.Date
  device          Device
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost            Decimal  @default(0) @db.Decimal(18, 6)
  conversions     Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue Decimal  @default(0) @db.Decimal(18, 6)
  currencyCode    String   @db.Char(3)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date, device])
  @@index([organizationId, adAccountId, date, device])
  @@index([organizationId, date, campaignId])
}

/// Geographic performance segmented by device so that location and device filters can be combined.
model LocationDailyMetric {
  id              String   @id @default(cuid())
  organizationId  String
  adAccountId     String
  campaignId      String
  date            DateTime @db.Date
  locationId      String
  locationName    String
  countryCode     String   @db.Char(2)
  device          Device
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost            Decimal  @default(0) @db.Decimal(18, 6)
  conversions     Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue Decimal  @default(0) @db.Decimal(18, 6)
  currencyCode    String   @db.Char(3)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date, locationId, device])
  @@index([organizationId, adAccountId, date, locationId])
  @@index([organizationId, date, campaignId])
}

model LandingPageDailyMetric {
  id              String   @id @default(cuid())
  organizationId  String
  adAccountId     String
  campaignId      String
  landingPageId   String
  date            DateTime @db.Date
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cost            Decimal  @default(0) @db.Decimal(18, 6)
  conversions     Decimal  @default(0) @db.Decimal(18, 6)
  conversionValue Decimal  @default(0) @db.Decimal(18, 6)
  /// GA4 metrics — null when no analytics property is linked or the row could not be reliably joined.
  sessions        Int?
  engagedSessions Int?
  keyEvents       Decimal? @db.Decimal(18, 6)
  analyticsJoined Boolean  @default(false)
  currencyCode    String   @db.Char(3)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, campaignId, date])
  @@index([organizationId, adAccountId, date])
  @@index([organizationId, campaignId, date])
}

// ─────────────────────────────── Targets, alerts, recommendations ───────────────────────────────

model PerformanceTarget {
  id             String       @id @default(cuid())
  organizationId String
  scope          TargetScope
  /// "org" | "account:<id>" | "campaign:<id>" — makes the uniqueness constraint work with nullable scope columns.
  scopeKey       String
  metric         TargetMetric
  value          Decimal      @db.Decimal(18, 6)
  adAccountId    String?
  campaignId     String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount    AdAccount?   @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("TargetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, scopeKey, metric])
  @@index([organizationId, metric])
}

model AlertRule {
  id             String        @id @default(cuid())
  organizationId String
  type           AlertType
  name           String
  enabled        Boolean       @default(true)
  severity       AlertSeverity
  thresholds     Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@unique([organizationId, type])
}

model Alert {
  id                     String        @id @default(cuid())
  organizationId         String
  adAccountId            String?
  ruleId                 String?
  campaignId             String?
  type                   AlertType
  severity               AlertSeverity
  status                 AlertStatus   @default(OPEN)
  entityType             EntityType
  entityId               String?
  entityName             String?
  metric                 String
  currentValue           Decimal?      @db.Decimal(18, 6)
  baselineValue          Decimal?      @db.Decimal(18, 6)
  difference             Decimal?      @db.Decimal(18, 6)
  differencePercent      Decimal?      @db.Decimal(12, 4)
  windowStart            DateTime      @db.Date
  windowEnd              DateTime      @db.Date
  explanation            String
  suggestedInvestigation String
  fingerprint            String
  assigneeId             String?
  resolutionNote         String?
  acknowledgedAt         DateTime?
  resolvedAt             DateTime?
  lastDetectedAt         DateTime      @default(now())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount       AdAccount?           @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  rule            AlertRule?           @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  campaign        Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignee        User?                @relation("AlertAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  actions         OptimizationAction[]
  recommendations Recommendation[]

  @@index([organizationId, status, severity])
  @@index([organizationId, fingerprint])
  @@index([organizationId, campaignId])
  @@index([organizationId, createdAt])
}

model Recommendation {
  id              String               @id @default(cuid())
  organizationId  String
  adAccountId     String?
  campaignId      String?
  alertId         String?
  type            RecommendationType
  title           String
  rationale       String
  evidence        Json                 @default("[]")
  affectedMetrics String[]
  confidence      ConfidenceLevel
  status          RecommendationStatus @default(OPEN)
  entityType      EntityType
  entityId        String?
  entityName      String?
  fingerprint     String
  dismissalReason String?
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount    AdAccount?           @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  campaign     Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  alert        Alert?               @relation(fields: [alertId], references: [id], onDelete: SetNull)
  decidedBy    User?                @relation("RecommendationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  actions      OptimizationAction[]

  @@index([organizationId, status])
  @@index([organizationId, fingerprint])
}

// ─────────────────────────────── Optimization workspace ───────────────────────────────

model OptimizationAction {
  id                   String                @id @default(cuid())
  organizationId       String
  title                String
  description          String?
  hypothesis           String?
  expectedImpact       String?
  adAccountId          String?
  campaignId           String?
  adGroupId            String?
  metricToMonitor      String?
  baselineValue        Decimal?              @db.Decimal(18, 6)
  targetValue          Decimal?              @db.Decimal(18, 6)
  actualValue          Decimal?              @db.Decimal(18, 6)
  ownerId              String?
  createdById          String?
  priority             ActionPriority        @default(MEDIUM)
  status               ActionStatus          @default(BACKLOG)
  plannedDate          DateTime?             @db.Date
  completedAt          DateTime?
  evaluationDate       DateTime?             @db.Date
  actualResult         String?
  resultClassification ResultClassification?
  cancellationReason   String?
  alertId              String?
  recommendationId     String?
  /// Attachment references [{ name, url }]; binary content lives in the storage provider.
  attachments          Json                  @default("[]")
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount      AdAccount?      @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adGroup        AdGroup?        @relation(fields: [adGroupId], references: [id], onDelete: SetNull)
  owner          User?           @relation("ActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("ActionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  alert          Alert?          @relation(fields: [alertId], references: [id], onDelete: SetNull)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  comments       ActionComment[]

  @@index([organizationId, status, deletedAt])
  @@index([organizationId, ownerId])
  @@index([organizationId, campaignId])
}

model ActionComment {
  id             String   @id @default(cuid())
  organizationId String
  actionId       String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action       OptimizationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, actionId, createdAt])
}

model ChangeLog {
  id             String       @id @default(cuid())
  organizationId String
  entityType     EntityType
  entityId       String
  campaignId     String?
  field          String
  oldValue       String?
  newValue       String?
  source         ChangeSource @default(USER)
  changedById    String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, campaignId, createdAt])
}

// ─────────────────────────────── Reporting ───────────────────────────────

model ReportTemplate {
  id              String          @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  frequency       ReportFrequency
  sections        Json            @default("[]")
  isDefault       Boolean         @default(false)
  scheduleEnabled Boolean         @default(false)
  recipients      String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports      GeneratedReport[]

  @@unique([organizationId, name])
}

model GeneratedReport {
  id             String          @id @default(cuid())
  organizationId String
  templateId     String?
  title          String
  frequency      ReportFrequency
  format         ReportFormat
  status         ReportStatus    @default(QUEUED)
  periodStart    DateTime        @db.Date
  periodEnd      DateTime        @db.Date
  filters        Json            @default("{}")
  commentary     String?
  storageKey     String?
  fileSize       Int?
  error          String?
  idempotencyKey String?
  requestedById  String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  requestedBy  User?           @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
}

// ─────────────────────────────── Sync & operations ───────────────────────────────

model SyncJob {
  id             String              @id @default(cuid())
  organizationId String
  connectionId   String?
  adAccountId    String?
  provider       IntegrationProvider
  type           SyncType
  status         SyncStatus          @default(QUEUED)
  rangeStart     DateTime            @db.Date
  rangeEnd       DateTime            @db.Date
  rowsProcessed  Int                 @default(0)
  progress       Int                 @default(0)
  idempotencyKey String?
  triggeredById  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   OAuthConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  adAccount    AdAccount?       @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  triggeredBy  User?            @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  errors       SyncError[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model SyncError {
  id             String   @id @default(cuid())
  organizationId String
  syncJobId      String
  code           String
  message        String
  details        Json     @default("{}")
  retryable      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncJob      SyncJob      @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([syncJobId])
}

/// Append-only. UPDATE is blocked by a database trigger; DELETE is only permitted by the retention job.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorId, createdAt])
}

model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique
  description     String?
  enabled         Boolean  @default(false)
  /// Organizations for which the flag is enabled even when globally disabled.
  organizationIds String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
