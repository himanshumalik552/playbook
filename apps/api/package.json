  "devDependencies": {
    "@adpulse/eslint-config": "workspace:*",
    "@adpulse/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.0.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-watch": "^6.2.1",
    "typescript": "~5.7.2"
  }
}
