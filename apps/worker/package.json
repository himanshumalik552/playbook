{
  "name": "@adpulse/worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "seed": "tsx src/cli/seed.ts",
    "seed:prod": "node dist/cli/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@adpulse/config": "workspace:*",
    "@adpulse/core": "workspace:*",
    "@adpulse/database": "workspace:*",
    "@adpulse/kpi": "workspace:*",
    "@adpulse/mock-data": "workspace:*",
    "@adpulse/types": "workspace:*",
    "bullmq": "^5.34.4",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@adpulse/eslint-config": "workspace:*",
    "@adpulse/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
