{
  "name": "adpulse",
  "version": "1.0.0",
  "private": true,
  "description": "ADPULSE — Google Ads Performance Management Platform",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@adpulse/api --filter=@adpulse/worker --filter=@adpulse/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @adpulse/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @adpulse/database db:generate",
    "db:migrate": "pnpm --filter @adpulse/database db:migrate",
    "db:migrate:dev": "pnpm --filter @adpulse/database db:migrate:dev",
    "db:validate": "pnpm --filter @adpulse/database db:validate",
    "db:seed": "turbo run build --filter=@adpulse/worker^... && pnpm --filter @adpulse/worker seed",
    "db:reset": "pnpm --filter @adpulse/database db:reset",
    "audit:deps": "pnpm audit --audit-level high --prod",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2"
    }
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "~5.7.2"
  }
}
