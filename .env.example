# ADPULSE environment configuration. Copy to `.env` for local development.
# Every value below is validated with Zod at startup (packages/config/src/env.ts).
# Values marked dev-only are rejected when NODE_ENV=production.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=1.0.0

# ---------------------------------------------------------------- urls
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
API_PORT=3000
# Where the Vite dev server proxies /api. Change together with API_PORT.
VITE_API_PROXY_TARGET=http://localhost:3000
# Comma-separated list of allowed browser origins. Defaults to WEB_URL.
CORS_ORIGINS=
# Set to true when running behind Nginx / Azure front door so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# ---------------------------------------------------------------- data stores
# Matches the postgres/redis services in docker-compose.yml.
POSTGRES_USER=adpulse
POSTGRES_PASSWORD=adpulse_dev_only
POSTGRES_DB=adpulse
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://adpulse:adpulse_dev_only@localhost:5432/adpulse?schema=public
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- auth & crypto (dev-only values)
# Generate production values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-0123456789abcdefghijklmnop
JWT_REFRESH_SECRET=dev-only-refresh-secret-0123456789abcdefghijklmno
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=14
# 32-byte base64 key for AES-256-GCM token encryption. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
COOKIE_DOMAIN=
# Must be true in production (HTTPS). Browsers accept Secure cookies on http://localhost as well.
COOKIE_SECURE=false

# ---------------------------------------------------------------- integrations
# mock  = deterministic demo data, no Google credentials needed
# google = real Google Ads / GA4 APIs (requires the GOOGLE_* values below)
INTEGRATION_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google sign-in callback (must be registered in Google Cloud Console)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Google Ads / GA4 connection callback (must be registered in Google Cloud Console)
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) customer ID without dashes, when accessing client accounts through a manager.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# ---------------------------------------------------------------- storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=reports

# ---------------------------------------------------------------- observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
SENTRY_DSN=

# ---------------------------------------------------------------- email
# console = logs emails locally (bodies are never logged in production)
EMAIL_PROVIDER=console
EMAIL_FROM=ADPULSE <no-reply@adpulse.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---------------------------------------------------------------- api behaviour
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- jobs
# Hours are evaluated in each organization's timezone.
SYNC_LOCAL_HOUR=6
REPORT_LOCAL_HOUR=7
SYNC_LOOKBACK_DAYS=3
INITIAL_SYNC_DAYS=180
SCHEDULER_ENABLED=true
WORKER_CONCURRENCY=4
# Liveness/readiness endpoint of the worker process (/health/live, /health/ready).
WORKER_HEALTH_PORT=3001
# Leave empty to use Puppeteer's bundled Chromium.
PUPPETEER_EXECUTABLE_PATH=

# ---------------------------------------------------------------- docker-compose.production.yml only
# REDIS_URL must then include the password: redis://:<REDIS_PASSWORD>@redis:6379
REDIS_PASSWORD=
REGISTRY=adpulse
IMAGE_TAG=latest
WEB_PORT=8080

# ---------------------------------------------------------------- seed (development only)
SEED_ADMIN_EMAIL=admin@adpulse.local
# Leave empty to use the documented development passwords from README.md.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
